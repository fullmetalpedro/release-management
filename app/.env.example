# Copie para .env e preencha. Tudo é opcional: sem nada, a entrada é só por token pessoal.

# URL pública do front (em dev, o Vite).
APP_URL=http://localhost:5173
API_PORT=3001
# Atrás de um proxy reverso, use true: o limite de tentativas de entrada passa a contar por IP do usuário (lido de
# X-Forwarded-For) e não pelo IP do proxy. Sem proxy, deixe false, senão qualquer um forja o próprio IP.
TRUST_PROXY=false

# App registration no Microsoft Entra ID. Preenchido, a tela de entrada oferece "Conta Microsoft" além do token
# pessoal (que está sempre disponível). Exige também AZDO_ORG e SESSION_SECRET.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Precisa estar cadastrada como Redirect URI (Web) no app registration.
ENTRA_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# Organização do Azure DevOps (dev.azure.com/<org>) e projetos que aparecem no seletor, na ordem.
AZDO_ORG=
AZDO_PROJECTS=Invoicing

# Fluxo de branches.
DEVELOP_BRANCH=develop
# Candidatas a base da release, em ordem; vale a primeira que existir no repositório.
RELEASE_BASE_BRANCH=main,master
# Regex das branches de release. O padrão aceita release-sprint-35, release/2.15 e release/0.1.0 e deixa de fora
# branches de trabalho (release/131046-descricao) e hotfixes (release-sprint-35-hotfix).
RELEASE_PATTERN=^release[-/](sprint-)?\d+(\.\d+)*$
# Nome sugerido para a primeira release de um repositório que ainda não tem nenhuma.
RELEASE_FIRST=release-sprint-1

# Cifra o arquivo de sessões e assina os cookies. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Dias sem uso até a sessão vencer (padrão 30). Cada uso renova a contagem e o cookie.
# SESSION_MAX_AGE_DAYS=30
